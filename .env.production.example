# ==============================================================================
# AXM Nexus — Ishlab Chiqarish (Production) Muhit Konfiguratsiyasi Namunasi
# Nusxa olish uchun: cp .env.production.example .env && chmod 600 .env
# DIQQAT: Hech qachon bu faylga real maxfiy kalitlarni yozmang va Gitga qo'shmang!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TIZIM VA PORTLAR
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
# Agar host Nginx ishlatilsa, HTTP_PORT=8080 qilib o'rnating. To'g'ridan-to'g'ri bo'lsa 80.
HTTP_PORT=80

# ------------------------------------------------------------------------------
# 2. MA'LUMOTLAR BAZASI (PostgreSQL 16 yoki Neon Serverless Postgres)
# Tavsiya: Parol generatsiyasi uchun: openssl rand -base64 24
# ------------------------------------------------------------------------------
POSTGRES_DB=axvhub
POSTGRES_USER=axm_admin
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD_24_CHARS

# Agar Render yoki Neon ishlatilsa (NEON_URL yoki DATABASE_URL):
# NEON_URL=postgresql://neondb_owner:password@ep-hidden-pine-benajq9a-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require
# NEON_USER=neondb_owner
# NEON_PASS=CHANGE_ME_NEON_PASSWORD

# ------------------------------------------------------------------------------
# 2a. NEON S3 OBJECT STORAGE (Neon Files)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=neon
AWS_ENDPOINT_URL_S3=https://br-dark-math-beyvvxd8.storage.c-9.us-east-2.aws.neon.tech
AWS_ACCESS_KEY_ID=nak_live_a830d72ca13646aaae231f0a1c17d35e
AWS_SECRET_ACCESS_KEY=nsk_live_1f92bc1985936e64ba5131a79c12fa1e07ef821f54f8ab9f7d1c1cc1825e7bfc
AWS_REGION=us-east-2
S3_BUCKET_NAME=assets

# Hikari Connection Pool sozlamalari (VPS resursiga qarab 10-30 oraliqda)
DB_POOL_MAX=15
DB_POOL_MIN_IDLE=3

# ------------------------------------------------------------------------------
# 3. XABARLAR NAVBATI (RabbitMQ 3)
# Tavsiya: Parol generatsiyasi uchun: openssl rand -base64 24
# ------------------------------------------------------------------------------
RABBITMQ_USER=nexus_mq_user
RABBITMQ_PASSWORD=CHANGE_ME_GENERATE_RABBITMQ_PASSWORD_24_CHARS

# ------------------------------------------------------------------------------
# 4. XAVFSIZLIK VA JWT (HMAC-SHA256)
# Majburiy: Kamida 32 ta belgi (256-bit). Standart placeholder taqiqlangan!
# Generatsiya uchun buyruq: openssl rand -hex 32
# ------------------------------------------------------------------------------
APP_JWT_SECRET=CHANGE_ME_GENERATE_AT_LEAST_64_HEX_CHARS_KEY

# Domen va CORS sozlamalari (faqat rasmiy domenlarga ruxsat beriladi)
APP_BASE_URL=https://axm-nexus.uz
CORS_ALLOWED_ORIGINS=https://axm-nexus.uz,https://www.axm-nexus.uz

# Ommaviy ro'yxatdan o'tish (Productionda odatda false)
ALLOW_PUBLIC_REGISTRATION=false

# CAPTCHA tekshiruvi (Brute-force va botlardan himoyalanish)
CAPTCHA_REQUIRED=false

# ------------------------------------------------------------------------------
# 5. BOSHLANG'ICH SUPERADMIN HISOBI (Initial Bootstrap)
# Tizim birinchi marta ishga tushganda yaratiladi.
# Parol qoidalari: kamida 12 belgi, katta harf, kichik harf, raqam va maxsus belgi.
# Birinchi marta kirgach SUPER_ADMIN_BOOTSTRAP_ENABLED=false qilib qo'yish tavsiya etiladi.
# ------------------------------------------------------------------------------
SUPER_ADMIN_BOOTSTRAP_ENABLED=true
SUPER_ADMIN_BOOTSTRAP_USERNAME=superadmin
SUPER_ADMIN_BOOTSTRAP_PASSWORD=NexusAdmin2026!#Strong
SUPER_ADMIN_BOOTSTRAP_EMAIL=admin@axm-nexus.uz
SUPER_ADMIN_BOOTSTRAP_FULL_NAME=Tizim Bosh Administratori

# ------------------------------------------------------------------------------
# 6. SMTP ELEKTRON POCHTA (Email xabarnomalar va tasdiqlash uchun)
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-system-email@gmail.com
MAIL_PASSWORD=your-google-app-password-16-chars
MAIL_FROM=noreply@axm-nexus.uz

# ------------------------------------------------------------------------------
# 7. SUN'IY INTELLEKT (AI) PROVIDERLARI (Opsional)
# ------------------------------------------------------------------------------
AI_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=
OPENAI_API_KEY=
