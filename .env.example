# =================================================================
# AXM Nexus — Muhit Konfiguratsiyasi Misoli (.env.example)
# Hech qanday maxfiy kalitlar yoki parollarni bu yerga yozmang!
# Ushbu fayldan nusxa olib .env fayli yarating: cp .env.example .env
# =================================================================

# Server & Profile
SPRING_PROFILES_ACTIVE=local
BACKEND_PORT=8080
FRONTEND_PORT=5173
HTTP_PORT=80

# Database (PostgreSQL 16 / Local)
POSTGRES_DB=axvhub
POSTGRES_USER=izzatbek
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_PORT=5432

# Neon PostgreSQL (Cloud Serverless DB)
# NEON_URL=postgresql://neondb_owner:password@ep-hidden-pine-benajq9a-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require
# NEON_USER=neondb_owner
# NEON_PASS=your_neon_password_here

# Neon S3-Compatible Object Storage (Neon Files)
STORAGE_PROVIDER=neon
AWS_ENDPOINT_URL_S3=https://br-dark-math-beyvvxd8.storage.c-9.us-east-2.aws.neon.tech
AWS_ACCESS_KEY_ID=nak_live_your_neon_access_key_here
AWS_SECRET_ACCESS_KEY=nsk_live_your_neon_secret_key_here
AWS_REGION=us-east-2
S3_BUCKET_NAME=assets

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_AUTO_STARTUP=true

# SMTP Email
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-secure-app-password
MAIL_FROM=noreply@axm-nexus.uz

# Security & CORS
APP_JWT_SECRET=generate_a_random_base64_or_hex_key_at_least_256_bits_long
APP_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Provider Keys & Configuration (Optional)
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
OPENAI_API_KEY=
